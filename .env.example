# Anthropic API Key for answer generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding model: 'local' (sentence-transformers / chromadb default) or 'openai'
EMBEDDING_MODEL=local

# Path where Chroma vector database is stored
NOTES_QA_DB_PATH=./notes-qa.db

# Optional: Claude model to use for answer generation
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: OpenAI API Key (required only if EMBEDDING_MODEL=openai)
# OPENAI_API_KEY=your_openai_api_key_here
