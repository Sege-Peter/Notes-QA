# ==========================================================
# notes-qa Configuration
# ==========================================================

# ----------------------------------------------------------
# AI Provider Options:
# 'auto' (default) -> detects available key or falls back to offline
# 'offline'        -> 100% Zero API Key mode (no keys or internet needed)
# 'gemini'         -> Google Gemini (free API key from aistudio.google.com)
# 'anthropic'      -> Anthropic Claude
# ----------------------------------------------------------
LLM_PROVIDER=auto

# Google Gemini API Key (Free tier available at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic API Key (from https://console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Embedding model: 'local' (sentence-transformers / chromadb default) or 'openai'
EMBEDDING_MODEL=local

# Path where Chroma vector database is stored
NOTES_QA_DB_PATH=./.db

# Optional: Local Ollama model if running Ollama locally
# OLLAMA_MODEL=llama3
